# 秘密の値の名前だけを書く。値はここに書かない
# 手元の開発（npm run dev）：このファイルを .env.local に写し、Neon の dev ブランチの接続先を入れる
# 手元のテスト：このファイルを .env.test に写し、Neon の test ブランチの接続先を入れる
# 接続先は、Neon の画面の「Connect」で出る postgresql://... の文字列

DATABASE_URL=
# Vercel では Neon の連携が DATABASE_URL_UNPOOLED（プールを通さない接続先）も入れ、形の変更に使う。手元では書かなくてよい（DATABASE_URL を使う）
