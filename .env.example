# 秘密の値の名前だけを書く。値はここに書かない
# 手元の開発（npm run dev）：このファイルを .env.local に写し、Neon の dev ブランチの接続先を入れる
# 手元のテスト：このファイルを .env.test に写し、Neon の test ブランチの接続先を入れる
# 接続先は、Neon の画面の「Connect」で出る postgresql://... の文字列

DATABASE_URL=
# Vercel では Neon の連携が DATABASE_URL_UNPOOLED（プールを通さない接続先）も入れ、形の変更に使う。手元では書かなくてよい（DATABASE_URL を使う）

# ログインの cookie の署名に使う、32文字以上のでたらめな文字列（openssl rand -base64 32 などで作る）。
# 使う場所ごとに別の値にする。.env.test にも書く（画面のテストでは、アプリを next start で立ち上げ、値がないと動かないため）
BETTER_AUTH_SECRET=
# アプリの URL（例：http://localhost:3000）
BETTER_AUTH_URL=

# Google でのログイン。Google Cloud の「認証情報」で作った OAuth クライアントの ID と秘密の値。
# 戻り先（<アプリの URL>/api/auth/callback/google）は、本番と http://localhost:3000 だけを登録する
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# 自分の Google アカウントのメールアドレス。npm run user:create が読み、アカウントのメールアドレスをこれに合わせる
OWNER_GOOGLE_EMAIL=
